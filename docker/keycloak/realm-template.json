{
  "realm": "${SYSTEM_NAME}-${STAGE}",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 300,
  "passwordPolicy": "hashIterations(1)",
  "roles": {
    "realm": [
      { "name": "CUSTOMER", "description": "Regular user" },
      { "name": "ADMIN", "description": "Administrator" }
    ]
  },
  "clients": [
    {
      "clientId": "${SYSTEM_NAME}-frontend",
      "name": "Frontend (React SPA)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:3111/*",
        "http://localhost:3112/*",
        "http://localhost:3211/*",
        "http://localhost:3212/*",
        "http://localhost:3311/*",
        "http://localhost:3312/*",
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:3111",
        "http://localhost:3112",
        "http://localhost:3211",
        "http://localhost:3212",
        "http://localhost:3311",
        "http://localhost:3312",
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3111/*##http://localhost:3112/*##http://localhost:3211/*##http://localhost:3212/*##http://localhost:3311/*##http://localhost:3312/*##http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "${SYSTEM_NAME}-backend-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "${SYSTEM_NAME}-backend",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "${SYSTEM_NAME}-system-test",
      "name": "System Tests (TEST REALM ONLY - password grant)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "${SYSTEM_NAME}-backend-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "${SYSTEM_NAME}-backend",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "customer1",
      "email": "customer1@example.com",
      "firstName": "Test",
      "lastName": "Customer",
      "enabled": true,
      "emailVerified": true,
      "credentials": [ { "type": "password", "value": "customer1-test-password", "temporary": false } ],
      "realmRoles": [ "CUSTOMER" ]
    },
    {
      "username": "admin1",
      "email": "admin1@example.com",
      "firstName": "Test",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [ { "type": "password", "value": "admin1-test-password", "temporary": false } ],
      "realmRoles": [ "ADMIN" ]
    },
    {
      "username": "customer2",
      "email": "customer2@example.com",
      "firstName": "Other",
      "lastName": "Customer",
      "enabled": true,
      "emailVerified": true,
      "credentials": [ { "type": "password", "value": "customer2-test-password", "temporary": false } ],
      "realmRoles": [ "CUSTOMER" ]
    }
  ]
}
