# Cloud Run Keycloak. A new realm in the import dir is imported, so production gets its own realm:
#   shop       acceptance and QA, with the password-grant test client and test users
#   shop-prod  production: SPA client only, no test users, checked below so it can't regress
# Import files must be named <realm>-realm.json.
# No frontend URLs are baked in: --import-realm skips a realm that already exists, so the deploy
# sets the shop-frontend client's URLs through the admin API instead
# (.github/scripts/set-keycloak-client-urls.sh). The image is the same for every GCP project.
# Build context: docker/keycloak. Local compose keeps using shop-realm.json as is.
FROM alpine:3.20 AS realm
RUN apk add --no-cache jq
COPY shop-realm.json prod-realm.jq prod-realm-check.jq /
RUN jq -f /prod-realm.jq /shop-realm.json > /realm-prod.json \
    && jq -e -f /prod-realm-check.jq /realm-prod.json

FROM quay.io/keycloak/keycloak:26.0 AS builder
ENV KC_DB=postgres \
    KC_HEALTH_ENABLED=true
RUN /opt/keycloak/bin/kc.sh build

FROM quay.io/keycloak/keycloak:26.0
COPY --from=builder /opt/keycloak/ /opt/keycloak/
COPY shop-realm.json /opt/keycloak/data/import/shop-realm.json
COPY --from=realm /realm-prod.json /opt/keycloak/data/import/shop-prod-realm.json
# C1 JIT only: halves the boot on 1 vCPU (~18 s to ~9 s locally); peak throughput doesn't matter here.
ENV KC_DB=postgres \
    KC_HTTP_ENABLED=true \
    KC_PROXY_HEADERS=xforwarded \
    KC_HOSTNAME_BACKCHANNEL_DYNAMIC=true \
    JAVA_OPTS_APPEND=-XX:TieredStopAtLevel=1
EXPOSE 8080
ENTRYPOINT ["/opt/keycloak/bin/kc.sh"]
CMD ["start", "--optimized", "--import-realm"]
