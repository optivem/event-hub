# Cloud Run Keycloak. Every realm in the import dir is imported, so each stage gets its own realm,
# generated here from realm-template.json for the SYSTEM_NAME build argument:
#   <SYSTEM_NAME>-acceptance  the acceptance-real and acceptance-stub stacks, with the
#                             password-grant test client and test users
#   <SYSTEM_NAME>-qa          QA, same content as acceptance
#   <SYSTEM_NAME>-prod        production: SPA client only, no test users, checked below so it can't regress
# No frontend URLs are baked in: --import-realm skips a realm that already exists, so the deploy
# sets the <SYSTEM_NAME>-frontend client's URLs through the admin API instead
# (.github/scripts/set-keycloak-client-urls.sh). The image is the same for every stage.
# Build context: docker/keycloak. Local compose imports realm-template.json as is (see realm.jq).
FROM alpine:3.20 AS realm
RUN apk add --no-cache jq
ARG SYSTEM_NAME
COPY realm-template.json realm.jq prod-realm.jq prod-realm-check.jq /
RUN set -eu; test -n "${SYSTEM_NAME:-}" || { echo "SYSTEM_NAME build argument is required" >&2; exit 1; }; \
    mkdir /import; \
    for stage in acceptance qa; do \
      jq --arg system "$SYSTEM_NAME" --arg stage "$stage" -f /realm.jq /realm-template.json \
        > "/import/${SYSTEM_NAME}-${stage}-realm.json"; \
    done; \
    jq --arg system "$SYSTEM_NAME" --arg stage prod -f /realm.jq /realm-template.json \
      | jq --arg system "$SYSTEM_NAME" -f /prod-realm.jq > "/import/${SYSTEM_NAME}-prod-realm.json"; \
    jq -e --arg system "$SYSTEM_NAME" -f /prod-realm-check.jq "/import/${SYSTEM_NAME}-prod-realm.json"; \
    ! grep -l '\${' /import/*.json

FROM quay.io/keycloak/keycloak:26.0 AS builder
ENV KC_DB=postgres \
    KC_HEALTH_ENABLED=true
RUN /opt/keycloak/bin/kc.sh build

FROM quay.io/keycloak/keycloak:26.0
COPY --from=builder /opt/keycloak/ /opt/keycloak/
COPY --from=realm /import/ /opt/keycloak/data/import/
# C1 JIT only: halves the boot on 1 vCPU (~18 s to ~9 s locally); peak throughput doesn't matter here.
ENV KC_DB=postgres \
    KC_HTTP_ENABLED=true \
    KC_PROXY_HEADERS=xforwarded \
    KC_HOSTNAME_BACKCHANNEL_DYNAMIC=true \
    JAVA_OPTS_APPEND=-XX:TieredStopAtLevel=1
EXPOSE 8080
ENTRYPOINT ["/opt/keycloak/bin/kc.sh"]
CMD ["start", "--optimized", "--import-realm"]
